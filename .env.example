# Copy to .env and fill in. NEVER commit .env. Use separate keys for this project.

# --- Backend (FastAPI) ---
ENV=development                  # development | production (production turns /docs off)
DATABASE_URL=postgresql+psycopg://somajji:localdev@localhost:5432/somajji
ANTHROPIC_API_KEY=               # prepaid credits + monthly limit in the console
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=somajji-who
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=somajji
LANGSMITH_TRACING=true
DAILY_BUDGET_USD=1.00            # app stops LLM calls after this much per day
EVAL_BUDGET_USD=2.00             # cap for one evaluation run
BACKEND_TOKEN_SECRET=            # long random string, SAME value in web/.env.local
ADMIN_EMAILS=                    # comma separated; first admins
DEMO_MODE=false                  # true only for the public demo (fake users and data)
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (web/.env.local) ---
# AUTH_SECRET=                   # npx auth secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# BACKEND_TOKEN_SECRET=          # same as above
# NEXT_PUBLIC_API_URL=http://localhost:8000
